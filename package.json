{
	"name": "about-myself",
	"type": "module",
	"version": "1.0.1",
	"description": "My webiste CV",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hvidom/about-myself.git"
	},
	"keywords": [],
	"author": "hvidom",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/hvidom/about-myself/issues"
	},
	"homepage": "https://github.com/hvidom/about-myself#readme",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"start": "bun run generate-types && bun run astro dev --verbose",
		"dev": "astro dev",
		"browserslist": "bunx update-browserslist-db@latest",
		"build": "bun run generate-types && bun run sync && bun run astro build && bun run build:tailwind && bun run build:postcss",
		"sync": "astro sync",
		"build:tailwind": "bun x @tailwindcss/cli -i src/styles/global.css -o dist/global.css --minify",
		"build:postcss": "postcss dist/global.css -o dist/global.css",
		"generate-types": "wrangler types",
		"format": "bunx --bun @biomejs/biome format --write",
		"lint": "bunx --bun @biomejs/biome lint --write",
		"check": "bunx --bun @biomejs/biome check src --write",
		"deploy": "astro build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^13.6.0",
		"@astrojs/mdx": "^6.0.1",
		"@astrojs/react": "^5.0.6",
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.3",
		"@dotlottie/player-component": "^2.7.12",
		"@fontsource-variable/inter": "^5.2.8",
		"@tailwindcss/cli": "^4.3.0",
		"@tailwindcss/postcss": "^4.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"astro": "^6.4.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.17.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"rehype-external-links": "^3.0.0",
		"shadcn": "^4.9.0",
		"sharp": "^0.34.5",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"three": "^0.184.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/bun": "latest",
		"@types/three": "^0.184.1",
		"postcss": "^8.5.15",
		"postcss-cli": "^11.0.1",
		"wrangler": "^4.95.0"
	},
	"overrides": {
		"vite": "^7"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	}
}
