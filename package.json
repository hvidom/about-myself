{
	"name": "about-myself",
	"type": "module",
	"version": "1.0.1",
	"description": "My webiste CV",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hvidom/about-myself.git"
	},
	"keywords": [],
	"author": "hvidom",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/hvidom/about-myself/issues"
	},
	"homepage": "https://github.com/hvidom/about-myself#readme",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "bun run generate-types && astro dev --verbose",
		"build": "astro build",
		"build:full": "bun run generate-types && bun run sync && bun run check:types && bun run build",
		"check:types": "astro check",
		"sync": "astro sync",
		"preview": "astro build && astro preview",
		"astro": "astro",
		"generate-types": "wrangler types",
		"cf-typegen": "wrangler types",
		"browserslist": "bunx update-browserslist-db@latest",
		"format": "bunx --bun @biomejs/biome format --write",
		"lint": "bunx --bun @biomejs/biome lint --write",
		"check": "bunx --bun @biomejs/biome check src --write",
		"deploy": "bun run build:full && wrangler deploy",
		"deploy:proxy": "node scripts/deploy-proxy.mjs"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.4",
		"@astrojs/markdown-remark": "^7.3.2",
		"@astrojs/mdx": "^8.0.3",
		"@astrojs/react": "^7.0.1",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@lottiefiles/dotlottie-wc": "^0.10.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "^7.3.8",
		"baseline-browser-mapping": "^2.11.28",
		"caniuse-lite": "^1.0.30001816",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.4.0",
		"hono": "^4.13.13",
		"lucide-react": "^1.57.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"shadcn": "^4.21.4",
		"sharp": "^0.35.5",
		"simple-icons": "^16.35.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/ts-plugin": "^1.10.12",
		"@biomejs/biome": "2.5.15",
		"@types/bun": "^1.4.3",
		"typescript": "^6.0.3",
		"wrangler": "^4.151.0"
	},
	"overrides": {
		"@cloudflare/vite-plugin": "1.64.0"
	}
}
