// Cloudflare Pages project "hvidom" (hvidom.pages.dev): a thin edge proxy that lets the
// is-a.dev subdomain point at the about-myself Worker. is-a.dev can only CNAME to Pages,
// while the site itself runs as an SSR Worker (Brevo, forms, APIs).
// Deploy: bunx wrangler pages deploy --cwd proxy
{
	"$schema": "https://unpkg.com/wrangler@4.151.0/config-schema.json",
	"name": "hvidom",
	"pages_build_output_dir": "./public",
	"compatibility_date": "2026-10-01",
	"services": [{ "binding": "SITE", "service": "about-myself" }]
}
