---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class={cn(
    "inline-flex items-center rounded-sm border border-gold/30 px-1.5 py-px font-mono text-[10px] font-semibold tracking-[0.24em] whitespace-nowrap text-gold/90 uppercase",
    className,
  )}><slot /></span
>
