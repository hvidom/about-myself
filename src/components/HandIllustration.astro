---
// Import the raw SVG string content using Vite's ?raw modifier
import handSvgRaw from '@/assets/animate/hand.svg?raw';

interface Props {
  class?: string;
  animate?: boolean;
}

const { class: className, animate = true } = Astro.props;
---

<div 
  class:list={[
    "w-full h-full flex items-center justify-center overflow-hidden",
    // Optional glowing backdrop effect to blend with your space theme
    "drop-shadow-[0_0_35px_rgba(158,0,255,0.25)]", 
    className
  ]}
>
  {/* Inject the raw vector paths directly into the DOM */}
  <div 
    class:list={[
      "w-full h-full svg-container text-white fill-current",
      { "animate-float": animate }
    ]}
    set:html={handSvgRaw} 
  />
</div>

<style is:global>
  /* Ensure any internal SVG scaling maps responsively to the parent wrapper */
  .svg-container svg {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }

  /* Smooth performance-optimized floating animation loop */
  @keyframes spaceFloat {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(1deg);
    }
  }

  .animate-float {
    animation: spaceFloat 6s ease-in-out infinite;
  }
</style>