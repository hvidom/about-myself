---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, ""); // remove trailing slash
---

<header class="border-b border-border/40 backdrop-blur-md sticky top-0 z-50 bg-background/80 transition-all">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <span class="text-xl font-black tracking-tighter bg-clip-text text-transparent bg-linear-to-r from-primary to-emerald-400 group-hover:opacity-85 transition-opacity">
        hvidom
      </span>
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
    </a>
    
    <nav class="flex items-center gap-8 text-sm font-medium">
      <a 
        href="/" 
        class:list={[
          "transition-colors relative py-1 hover:text-foreground", 
          currentPath === "" ? "text-foreground font-semibold" : "text-muted-foreground"
        ]}
      >
        Home
        {currentPath === "" && (
          <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-primary rounded-full" />
        )}
      </a>
      
      <a 
        href="/blog" 
        class:list={[
          "transition-colors relative py-1 hover:text-foreground", 
          currentPath.startsWith("/blog") ? "text-foreground font-semibold" : "text-muted-foreground"
        ]}
      >
        Blog
        {currentPath.startsWith("/blog") && (
          <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-primary rounded-full" />
        )}
      </a>
    </nav>
    
    <div class="hidden sm:flex items-center gap-4 text-xs font-mono">
      <a 
        href="https://github.com/hvidom" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-muted-foreground hover:text-primary transition-colors py-1 px-2 rounded hover:bg-muted/40"
      >
        github
      </a>
      <a 
        href="https://www.linkedin.com/in/hryhorii-ilin-952426341" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-muted-foreground hover:text-primary transition-colors py-1 px-2 rounded hover:bg-muted/40"
      >
        linkedin
      </a>
    </div>
  </div>
</header>
