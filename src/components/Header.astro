---
import ClassificationBanner from "@/components/ClassificationBanner.astro";
import SkyToggle from "@/components/magic/SkyToggle.astro";
import { CODENAME } from "@/data/dossier";
import { LINKS } from "@/data/profile";

const path = Astro.url.pathname.replace(/\/$/, "");
const nav = [
  { href: "/", label: "home", active: path === "", wide: false },
  { href: "/#work", label: "work", active: false, wide: true },
  { href: "/#stack", label: "stack", active: false, wide: true },
  { href: "/blog/", label: "blog", active: path.startsWith("/blog"), wide: false },
];
---

<ClassificationBanner class="border-b" />

<header class="sticky top-0 z-50 border-b border-border bg-background/70 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-6">
    <a href="/" class="group flex items-center gap-1.5 font-mono text-lg font-bold tracking-tight" title={`${CODENAME}: Hryhorii Victorovich Ilin Document Object Model`}>
      <span class="text-violet" aria-hidden="true">~/</span><span class="text-brand">hvidom</span>
      <span class="ml-1 size-2 rounded-full bg-green shadow-[0_0_12px_var(--green)]" aria-hidden="true"></span>
      <span class="hidden rounded-sm border border-gold/30 px-1.5 py-px text-[9px] font-semibold tracking-[0.2em] text-gold/90 uppercase lg:inline" aria-hidden="true">dom</span>
    </a>

    <nav aria-label="Main" class="flex items-center gap-1 font-mono text-sm sm:gap-2">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            class:list={[
              "rounded-lg px-2.5 py-1.5 transition-colors hover:bg-muted/60 hover:text-foreground",
              item.active ? "text-turquoise" : "text-muted-foreground",
              item.wide && "hidden sm:inline-flex",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <SkyToggle />
      <a
        href={LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden size-9 place-items-center rounded-lg text-muted-foreground transition-colors hover:bg-muted/60 hover:text-turquoise sm:grid"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 24 24" class="size-[18px]" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3"></path></svg>
      </a>
      <a
        href={LINKS.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden size-9 place-items-center rounded-lg text-muted-foreground transition-colors hover:bg-muted/60 hover:text-turquoise sm:grid"
        aria-label="LinkedIn"
      >
        <svg viewBox="0 0 24 24" class="size-[17px]" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path></svg>
      </a>
    </div>
  </div>
</header>
