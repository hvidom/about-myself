---
type Box = {
  x: number;
  y: number;
  w: number;
  h: number;
  title: string;
  sub?: string;
  tone?: string;
};

const boxes: Box[] = [
  { x: 10, y: 66, w: 124, h: 56, title: "Visitors", sub: "customers, Google" },
  { x: 10, y: 160, w: 124, h: 56, title: "Team", sub: "browser + SSO" },
  { x: 176, y: 58, w: 142, h: 56, title: "Website", sub: "Astro on Workers", tone: "turquoise" },
  {
    x: 332,
    y: 58,
    w: 142,
    h: 56,
    title: "CDN · TLS · WAF",
    sub: "DDoS and bot rules",
    tone: "turquoise",
  },
  {
    x: 518,
    y: 58,
    w: 232,
    h: 56,
    title: "GitHub org, private repo",
    sub: "content in git, CI builds the site",
  },
  { x: 176, y: 286, w: 368, h: 30, title: "cloudflared: outbound-only tunnel, no open ports" },
  { x: 176, y: 326, w: 176, h: 50, title: "Admin + API", sub: "Bun · Hono · React", tone: "gold" },
  { x: 368, y: 326, w: 176, h: 50, title: "PostgreSQL", sub: "private network only", tone: "gold" },
  { x: 176, y: 386, w: 176, h: 50, title: "Mail inbox", sub: "sending via a relay" },
  { x: 368, y: 386, w: 176, h: 50, title: "Scheduled syncs", sub: "SEO · GSC · ad spend" },
];
const apis = ["DataForSEO", "PostHog EU", "Search Console", "Claude · Stripe"];
const pulses: [string, number][] = [
  ["M134 94H172", 0],
  ["M134 188H172", 0.7],
  ["M518 86H478", 1.3],
  ["M325 210V282", 0.4],
  ["M544 411H582", 1],
  ["M530 250C560 200 635 170 635 118", 1.8],
];
const fill: Record<string, string> = {
  turquoise: "fill-turquoise/10 stroke-turquoise/60",
  gold: "fill-gold/10 stroke-gold/60",
};
---

<svg
  viewBox="0 0 760 466"
  class="block h-auto w-full min-w-[640px]"
  role="img"
  aria-labelledby="arch-title arch-desc"
>
  <title id="arch-title">System architecture of the Radio King platform</title>
  <desc id="arch-desc">
    Visitors reach the Astro website on Cloudflare's edge. The team reaches the admin through Cloudflare Access and an
    outbound-only tunnel to one Oracle ARM server that runs the admin, the API, PostgreSQL, mail and scheduled syncs. The
    admin publishes content as git commits; CI builds the site and deploys it to Cloudflare. Syncs pull data from
    DataForSEO, PostHog, Search Console, Claude and Stripe.
  </desc>
  <defs>
    <marker id="arch-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 8 4 0 8z" class="fill-muted-foreground" />
    </marker>
  </defs>

  <rect x="160" y="20" width="330" height="204" rx="16" class="fill-turquoise/[0.03] stroke-turquoise/50" stroke-dasharray="5 5" />
  <text x="176" y="42" class="fill-turquoise font-mono text-[11px] font-semibold tracking-[0.12em]">CLOUDFLARE EDGE · FREE TIER</text>
  <rect x="176" y="126" width="298" height="34" rx="9" class="fill-card stroke-border" />
  <text x="325" y="147" text-anchor="middle" class="fill-muted-foreground text-[11.5px]">1:1 301 redirects · sitemap · Stripe Checkout</text>
  <rect x="176" y="172" width="298" height="38" rx="9" class="fill-violet/10 stroke-violet/60" />
  <text x="325" y="195" text-anchor="middle" class="fill-foreground text-[12px] font-semibold">Cloudflare Access: team login</text>

  <rect x="160" y="250" width="400" height="204" rx="16" class="fill-gold/[0.03] stroke-gold/50" stroke-dasharray="5 5" />
  <text x="176" y="274" class="fill-gold font-mono text-[11px] font-semibold tracking-[0.12em]">ORACLE ARM · ALWAYS FREE · ONE DOCKER HOST</text>

  <rect x="586" y="250" width="164" height="204" rx="16" class="fill-none stroke-border" />
  <text x="600" y="274" class="fill-muted-foreground font-mono text-[11px] font-semibold tracking-[0.12em]">EXTERNAL APIS</text>
  {
    apis.map((name, i) => (
      <g>
        <rect x="600" y={290 + i * 38} width="136" height="28" rx="8" class="fill-card stroke-border" />
        <text x="668" y={308 + i * 38} text-anchor="middle" class="fill-foreground text-[11.5px]">{name}</text>
      </g>
    ))
  }

  {
    boxes.map((b) => (
      <g>
        <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="11" class={b.tone ? fill[b.tone] : "fill-card stroke-border"} />
        <text
          x={b.x + b.w / 2}
          y={b.sub ? b.y + b.h / 2 - 3 : b.y + b.h / 2 + 4}
          text-anchor="middle"
          class:list={["fill-foreground font-semibold", b.sub ? "text-[13px]" : "text-[11.5px] font-normal"]}
        >
          {b.title}
        </text>
        {b.sub && (
          <text x={b.x + b.w / 2} y={b.y + b.h / 2 + 14} text-anchor="middle" class="fill-muted-foreground text-[11px]">
            {b.sub}
          </text>
        )}
      </g>
    ))
  }

  <g class="fill-none stroke-muted-foreground" stroke-width="1.5" marker-end="url(#arch-arrow)">
    <path d="M134 94H172" />
    <path d="M134 188H172" />
    <path d="M518 86H478" />
    <path d="M325 210V282" />
    <path d="M352 351H364" marker-start="url(#arch-arrow)" />
    <path d="M544 411H582" />
    <path d="M530 250C560 200 635 170 635 118" stroke-dasharray="4 4" />
  </g>
  <g class="stroke-turquoise" stroke-width="2.5">
    {
      pulses.map(([d, delay]) => (
        <path d={d} pathLength="1" class="beam-pulse" style={`--beam-delay: ${delay}s; --beam-duration: 2.6s`} />
      ))
    }
  </g>
  <text x="333" y="240" class="fill-muted-foreground text-[11px]">tunnel</text>
  <text x="606" y="212" class="fill-muted-foreground text-[11px]">publish = git commit</text>
  <text x="498" y="80" text-anchor="middle" class="fill-muted-foreground text-[10px]">deploy</text>
</svg>
