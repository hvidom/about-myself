---
import type { Tone } from "@/data/profile";

interface Props {
  label: string;
  tone?: Tone;
}

const { label, tone = "gold" } = Astro.props;
---

<aside class="callout my-8 rounded-r-xl border-l-2 px-5 py-4" style={`--tone: var(--${tone})`}>
  <p class="mt-0 font-mono text-[10px] font-semibold tracking-[0.28em] uppercase">{label}</p>
  <div class="callout-body mt-2 text-[0.95rem] leading-7 text-foreground/90"><slot /></div>
</aside>

<style>
  .callout {
    border-color: var(--tone);
    background: color-mix(in oklch, var(--tone) 8%, transparent);
  }
  .callout > p {
    color: var(--tone);
  }
  .callout-body :global(p) {
    margin-top: 0.75rem;
  }
  .callout-body :global(p:first-child) {
    margin-top: 0;
  }
  .callout-body :global(ul) {
    margin-block: 0.75rem 0;
  }
</style>
