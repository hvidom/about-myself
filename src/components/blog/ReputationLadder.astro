---
const themes = [
  { name: "Default", at: 10, dot: "fill-muted-foreground" },
  { name: "Iron", at: 20, dot: "fill-foreground/45" },
  { name: "Bronze", at: 50, dot: "fill-gold/55" },
  { name: "Silver", at: 100, dot: "fill-foreground/80" },
  { name: "Gold", at: 500, dot: "fill-gold" },
  { name: "Platinum", at: 1000, dot: "fill-cyan" },
  { name: "Diamond", at: 5000, dot: "fill-turquoise" },
  { name: "Legendary", at: 10000, dot: "fill-pink" },
];
const unlocks = [
  {
    at: 250,
    dy: 62,
    lines: [
      "250: privileges unlocked. Your votes now move other",
      "people's reputation, you can suggest sources, and",
      "Squads you run can show up in discovery",
    ],
  },
  { at: 100, dy: 126, lines: ["over 100: no daily limit on posts and comments"] },
];
const me = 10;
const fmt = (n: number) => n.toLocaleString("en-US");

const LEFT = 44;
const W = 630;
const AXIS = 104;
const px = (v: number) => LEFT + (Math.log10(v / 10) / 3) * W;
---

<svg viewBox="0 0 720 244" class="block h-auto w-full min-w-[600px]" role="img" aria-labelledby="ladder-title ladder-desc">
  <title id="ladder-title">What reputation unlocks, from 10 to 10,000</title>
  <desc id="ladder-desc">
    Log scale. DevCard themes: {themes.map((t) => `${t.name} at ${fmt(t.at)}`).join(", ")}. Unlocks: {unlocks.map((u) => u.lines.join(" ")).join("; ")}. I am at {me}, the
    reputation every account starts with.
  </desc>

  <text x={LEFT - 4} y="18" class="fill-muted-foreground font-mono text-[10.5px] tracking-[0.18em] uppercase">DevCard themes</text>

  <line x1={LEFT} x2={LEFT + W} y1={AXIS} y2={AXIS} class="stroke-border" stroke-width="2" stroke-linecap="round" />
  <line x1={px(me)} x2={px(250)} y1={AXIS} y2={AXIS} class="stroke-turquoise/70" stroke-width="2" stroke-dasharray="3 5" stroke-linecap="round" />

  {
    themes.map((t) => (
      <g>
        <line x1={px(t.at)} x2={px(t.at)} y1={AXIS - 22} y2={AXIS} class="stroke-border" stroke-width="1" />
        <circle cx={px(t.at)} cy={AXIS} r="6" class:list={[t.dot, "stroke-background"]} stroke-width="2">
          <title>{`${t.name} theme: ${fmt(t.at)} reputation`}</title>
        </circle>
        <text x={px(t.at)} y={AXIS - 46} text-anchor="middle" class="fill-foreground text-[12px] font-semibold">
          {t.name}
        </text>
        <text x={px(t.at)} y={AXIS - 30} text-anchor="middle" class="fill-muted-foreground font-mono text-[10.5px] tabular-nums">
          {fmt(t.at)}
        </text>
      </g>
    ))
  }

  {
    unlocks.map((u) => {
      const top = AXIS + u.dy;
      return (
        <g>
          <line x1={px(u.at)} x2={px(u.at)} y1={AXIS + 8} y2={top - 12} class="stroke-gold/60" stroke-width="1" stroke-dasharray="2 3" />
          {!themes.some((t) => t.at === u.at) && <circle cx={px(u.at)} cy={AXIS} r="4" class="fill-gold" />}
          {u.lines.map((line, j) => (
            <text x={px(u.at) + 6} y={top + j * 16} class:list={[j === 0 ? "fill-foreground font-semibold" : "fill-muted-foreground", "text-[11.5px]"]}>
              {line}
            </text>
          ))}
        </g>
      );
    })
  }

  <g>
    <path d={`M${px(me)} ${AXIS + 10}l-6 10h12z`} class="fill-turquoise" />
    <text x={px(me) - 6} y={AXIS + 38} class="fill-turquoise text-[12px] font-semibold">me: {me}</text>
    <text x={px(me) - 6} y={AXIS + 54} class="fill-muted-foreground text-[11px]">the sign-up value</text>
  </g>
</svg>
