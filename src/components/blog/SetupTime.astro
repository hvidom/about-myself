---
const rows = [
  { step: "1 · DNSSEC", minutes: 10, wait: "DS live in 1–48 h" },
  { step: "2 · Email Routing", minutes: 10, wait: "DNS in 5–15 min" },
  { step: "3 · Brevo domain", minutes: 15, wait: "DNS in 5–15 min" },
  { step: "4 · Gmail sends as sales@", minutes: 10 },
  { step: "5 · Signatures", minutes: 15 },
  { step: "6 · DMARC ladder", minutes: 20, wait: "4 edits over 6–8 weeks" },
  { step: "7 · Lists, form, first campaign", minutes: 45 },
];
const LABEL = 232;
const PLOT = 280;
const MAX = 50;
const ROW = 34;
const BAR = 16;
const ticks = [0, 10, 20, 30, 40, 50];
const bx = (v: number) => LABEL + (v / MAX) * PLOT;
const height = rows.length * ROW + 34;
const total = rows.reduce((sum, r) => sum + r.minutes, 0);
const bar = (y: number, w: number) => {
  const r = Math.min(4, w);
  return `M${LABEL} ${y}H${LABEL + w - r}Q${LABEL + w} ${y} ${LABEL + w} ${y + r}V${y + BAR - r}Q${LABEL + w} ${y + BAR} ${LABEL + w - r} ${y + BAR}H${LABEL}Z`;
};
---

<svg viewBox={`0 0 720 ${height}`} class="block h-auto w-full min-w-[580px]" role="img" aria-labelledby="time-title time-desc">
  <title id="time-title">Hands-on minutes per setup step, about {total} minutes in total</title>
  <desc id="time-desc">{rows.map((r) => `${r.step}: ${r.minutes} minutes${r.wait ? `, then ${r.wait}` : ""}`).join("; ")}.</desc>

  {
    ticks.map((t) => (
      <g>
        <line x1={bx(t)} x2={bx(t)} y1="4" y2={rows.length * ROW + 4} class="stroke-border" stroke-width="1" />
        <text x={bx(t)} y={rows.length * ROW + 24} text-anchor="middle" class="fill-muted-foreground font-mono text-[11px] tabular-nums">
          {t === MAX ? `${t} min` : t}
        </text>
      </g>
    ))
  }

  {
    rows.map((row, i) => {
      const y = 4 + i * ROW + (ROW - BAR) / 2;
      const w = (row.minutes / MAX) * PLOT;
      return (
        <g>
          <text x={LABEL - 12} y={y + 12.5} text-anchor="end" class="fill-foreground text-[12.5px]">
            {row.step}
          </text>
          <path d={bar(y, w)} class="fill-cyan">
            <title>{`${row.step}: ${row.minutes} min${row.wait ? ` · then ${row.wait}` : ""}`}</title>
          </path>
          <text x={bx(row.minutes) + 8} y={y + 12.5} class="fill-foreground text-[12px] font-semibold tabular-nums">
            {row.minutes}
            {row.wait && <tspan class="fill-muted-foreground font-mono text-[10.5px] font-normal"> · {row.wait}</tspan>}
          </text>
        </g>
      );
    })
  }
</svg>
