---
import { TONE, type Tone } from "@/data/profile";
import { cn } from "@/lib/utils";

interface Props {
  stats: { value: string; label: string; tone?: Tone }[];
}

const { stats } = Astro.props;
---

<dl class:list={["my-8 grid gap-3", stats.length === 2 ? "grid-cols-2" : "grid-cols-2 lg:grid-cols-4"]}>
  {
    stats.map(({ value, label, tone = "turquoise" }) => (
      <div class="glass flex flex-col-reverse justify-end rounded-2xl px-4 py-4">
        <dt class="mt-1.5 text-xs leading-snug text-muted-foreground">{label}</dt>
        <dd class={cn("text-2xl font-black sm:text-3xl", TONE[tone].text)}>{value}</dd>
      </div>
    ))
  }
</dl>
