---
import { cardVariants } from "@/components/ui/card";
import { EXPERTISE, TONE } from "@/data/profile";
import { cn } from "@/lib/utils";
import SectionHeading from "./SectionHeading.astro";
---

<section aria-labelledby="expertise-title" class="space-y-10">
  <SectionHeading eyebrow="man hvidom" title="Areas of expertise" id="expertise-title">
    Where business questions turn into reliable software.
  </SectionHeading>

  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      EXPERTISE.map((module) => {
        const tone = TONE[module.tone];
        return (
          <li class={cn(cardVariants({ variant: "glass" }), "gap-4 rounded-2xl px-6 py-6")}>
            <p class={cn("font-mono text-[11px] font-bold tracking-wide", tone.text)}>{module.code}</p>
            <h3 class="text-lg font-bold tracking-tight text-foreground">{module.title}</h3>
            <ul class="space-y-2 text-sm text-muted-foreground">
              {module.items.map((item) => (
                <li class="flex items-center gap-2.5">
                  <span class={cn("size-1.5 shrink-0 rounded-full", tone.dot)} aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          </li>
        );
      })
    }
  </ul>
</section>
