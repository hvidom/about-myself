---
import {
  type SimpleIcon,
  siClaude,
  siCloudflare,
  siGmail,
  siGooglesearchconsole,
  siInstagram,
  siMessenger,
  siPostgresql,
  siStripe,
  siWhatsapp,
} from "simple-icons";
import AnimatedBeam from "@/components/magic/AnimatedBeam.astro";
import { CF_FLOW } from "@/data/profile";
import { iconColor } from "@/lib/icon-color";

type Icon = Pick<SimpleIcon, "hex" | "path">;

const chat: Icon = {
  hex: "000000",
  path: "M12 2C6.5 2 2 6 2 10.9c0 2.6 1.3 5 3.4 6.6L4.6 22l4.6-2.6c.9.2 1.8.3 2.8.3 5.5 0 10-4 10-8.8S17.5 2 12 2zm-4.5 10.2a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6zm4.5 0a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6zm4.5 0a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6z",
};
const icons: Icon[] = [siWhatsapp, siMessenger, siInstagram, siGmail, chat];
const outIcons: Icon[] = [siCloudflare, siStripe, siPostgresql, siClaude, siGooglesearchconsole];
const bends = [-36, -18, 0, 18, 36];
const inputs = CF_FLOW.inputs.map((label, i) => ({ label, icon: icons[i]!, id: `in-${i}` }));
const outputs = CF_FLOW.outputs.map((label, i) => ({ label, icon: outIcons[i]!, id: `out-${i}` }));
---

<figure class="relative py-2" data-beam-root>
  <figcaption class="sr-only">
    Messages from {CF_FLOW.inputs.join(", ")} flow into {CF_FLOW.hub}, which drives {CF_FLOW.outputs.join(", ")}.
  </figcaption>

  <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-x-8 sm:gap-x-16">
    <ul class="flex flex-col items-end gap-3.5" aria-hidden="true">
      {
        inputs.map(({ label, icon, id }) => (
          <li class="flex items-center gap-3">
            <span class="hidden font-mono text-[11px] text-muted-foreground sm:inline">{label}</span>
            <span class="relative z-10 grid size-10 place-items-center rounded-full border border-border bg-card shadow-[0_0_24px_-8px_var(--green)] sm:size-11" data-beam-node={id}>
              <svg viewBox="0 0 24 24" class="size-5" style={`fill:${iconColor(icon.hex)}`}><path d={icon.path} /></svg>
            </span>
          </li>
        ))
      }
    </ul>

    <div class="flex flex-col items-center gap-2" aria-hidden="true">
      <span
        class="relative z-10 grid size-20 place-items-center rounded-3xl border border-turquoise/40 bg-card shadow-[0_0_48px_-12px_var(--turquoise)] sm:size-24"
        data-beam-node="hub"
      >
        <span class="text-brand font-heading text-2xl sm:text-3xl">CF</span>
      </span>
      <span class="font-mono text-[10px] tracking-[0.2em] text-muted-foreground uppercase">{CF_FLOW.hub}</span>
    </div>

    <ul class="flex flex-col items-start gap-3.5" aria-hidden="true">
      {
        outputs.map(({ label, icon, id }) => (
          <li class="flex items-center gap-3">
            <span class="relative z-10 grid size-10 place-items-center rounded-full border border-border bg-card shadow-[0_0_24px_-8px_var(--violet)] sm:size-11" data-beam-node={id}>
              <svg viewBox="0 0 24 24" class="size-5" style={`fill:${iconColor(icon.hex)}`}><path d={icon.path} /></svg>
            </span>
            <span class="hidden font-mono text-[11px] text-muted-foreground sm:inline">{label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  {
    inputs.map(({ id }, i) => (
      <AnimatedBeam from={id} to="hub" curvature={bends[i]} start="green" stop="turquoise" duration={3.6 + i * 0.25} delay={i * 0.45} />
    ))
  }
  {
    outputs.map(({ id }, i) => (
      <AnimatedBeam from="hub" to={id} curvature={-bends[i]!} start="turquoise" stop="violet" duration={3.8 + i * 0.2} delay={1.2 + i * 0.4} />
    ))
  }
</figure>
