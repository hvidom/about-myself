---
import LottieAnimation from "@/components/LottieAnimations.astro";
import Redacted from "@/components/magic/Redacted.astro";
import Stamp from "@/components/magic/Stamp.astro";
import TextAnimate from "@/components/magic/TextAnimate.astro";
import TypingAnimation from "@/components/magic/TypingAnimation.astro";
import { badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { ACRONYM, SUBJECT } from "@/data/dossier";
import { HERO_STACK, LINKS, PHRASES } from "@/data/profile";
---

<section aria-labelledby="hero-title" class="grid items-center gap-12 pt-6 lg:grid-cols-12 lg:pt-12">
  <div class="min-w-0 space-y-7 lg:col-span-7">
    <dl class="flex flex-wrap gap-x-5 gap-y-1.5 border-y border-dashed border-gold/25 py-2.5 font-mono text-[11px] tracking-[0.14em] uppercase" aria-label="Dossier">
      {
        SUBJECT.map(({ key, value, redact }) => (
          <div class="flex gap-2">
            <dt class="text-gold/80">{key}</dt>
            <dd class="text-foreground/85">
              {redact ? (
                <>
                  {value.split(redact)[0]}
                  <Redacted delay={900}>{redact}</Redacted>
                  {value.split(redact)[1]}
                </>
              ) : (
                value
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="flex flex-col items-start gap-2.5">
      <p
        class="inline-flex items-center gap-2.5 rounded-full border border-green/30 bg-green/10 px-3.5 py-1.5 font-mono text-xs tracking-[0.16em] text-green uppercase"
      >
        <span class="relative flex size-2" aria-hidden="true">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-green opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-green"></span>
        </span>
        Based in Dublin, Ireland
        <span class="flex h-3 overflow-hidden rounded-[2px]" aria-hidden="true">
          <span class="w-1.5 bg-[#169b62]"></span><span class="w-1.5 bg-white"></span><span class="w-1.5 bg-[#ff883e]"></span>
        </span>
      </p>
      <p
        class="inline-flex items-center gap-2.5 rounded-full border border-gold/30 bg-gold/10 px-3.5 py-1.5 font-mono text-xs tracking-[0.16em] text-gold uppercase"
      >
        Made in Ukraine
        <span class="flex h-3 w-4.5 flex-col overflow-hidden rounded-[2px]" aria-hidden="true">
          <span class="flex-1 bg-[#0057b7]"></span><span class="flex-1 bg-[#ffd700]"></span>
        </span>
      </p>
    </div>

    <div class="space-y-3">
      <h1 id="hero-title" class="text-brand pb-1 text-5xl leading-[1.05] font-black tracking-tight sm:text-6xl lg:text-7xl">
        Hryhorii Ilin
      </h1>
      <p class="font-mono text-sm text-muted-foreground">
        <span class="sr-only">hvidom stands for Hryhorii Victorovich Ilin, Document Object Model.</span>
        <span class="flex flex-wrap items-baseline gap-x-2 gap-y-1" aria-hidden="true">
          {
            ACRONYM.map(({ letter, word, half }, i) => (
              <>
                {i === 3 && <span class="text-gold/60">//</span>}
                <span>
                  <b class:list={["font-bold", half === "subject" ? "text-turquoise" : "text-violet"]}>{letter}</b>{word.slice(1)}
                </span>
              </>
            ))
          }
        </span>
      </p>
    </div>

    <TextAnimate
      class="text-lg text-muted-foreground sm:text-xl"
      text="Full-stack developer · infrastructure tinkerer · ex-sales director"
      label="Full-stack developer, infrastructure tinkerer, ex-sales director"
      dim={["·"]}
    />

    <div
      class="glass flex h-12 max-w-xl items-center gap-2.5 overflow-hidden rounded-xl px-4 font-mono text-[15px]"
      data-typewriter
      data-phrases={JSON.stringify(PHRASES)}
    >
      <span class="text-violet" aria-hidden="true">~</span>
      <span class="text-green" aria-hidden="true">$</span>
      <TypingAnimation
        words={PHRASES}
        loop
        startOnView={false}
        reserve={false}
        typeSpeed={45}
        deleteSpeed={18}
        pauseDelay={2200}
        cursor="block"
        class="min-w-0 text-turquoise"
        textClass="truncate"
        cursorClass="rounded-[2px]"
      />
    </div>

    <ul class="flex flex-wrap gap-2" aria-label="Daily stack">
      {HERO_STACK.map((item) => <li class={badgeVariants({ variant: "chip" })}>{item}</li>)}
    </ul>

    <div class="flex flex-wrap gap-3 pt-2">
      <a href="#journey" class={buttonVariants({ variant: "brand", size: "xl" })}>
        Explore my journey
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
      </a>
      <a href={LINKS.github} target="_blank" rel="noopener noreferrer" class={buttonVariants({ variant: "outline", size: "xl" })}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path></svg>
        GitHub profile
      </a>
    </div>
  </div>

  <div class="relative mx-auto aspect-square w-full max-w-76 sm:max-w-md lg:col-span-5 lg:max-w-none">
    <div class="pointer-events-none absolute inset-[18%] rounded-full bg-turquoise/30 blur-2xl sm:inset-[10%] sm:blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-[28%] translate-x-[12%] rounded-full bg-violet/30 blur-2xl sm:inset-[24%] sm:translate-x-1/4 sm:blur-3xl" aria-hidden="true"></div>
    <LottieAnimation src="/animations/hacker.lottie" class="relative size-full" />
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <Stamp text="Declassified" sub="for public release" class="absolute top-[9%] right-[5%] text-base sm:text-xl" tilt={-11} />
    </div>
    <p class="absolute inset-x-0 bottom-[2%] text-center font-mono text-[10px] tracking-[0.3em] text-muted-foreground/80 uppercase" aria-hidden="true">
      Exhibit A · subject at work
    </p>
  </div>
</section>
