---
import { badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { HERO_STACK, LINKS, PHRASES } from "@/data/profile";
import { shooterSvg } from "@/lib/shooter";

const radar = shooterSvg();
---

<section aria-labelledby="hero-title" class="grid items-center gap-12 pt-6 lg:grid-cols-12 lg:pt-12">
  <div class="space-y-7 lg:col-span-7">
    <p
      class="inline-flex items-center gap-2.5 rounded-full border border-green/30 bg-green/10 px-3.5 py-1.5 font-mono text-xs tracking-[0.16em] text-green uppercase"
    >
      <span class="relative flex size-2" aria-hidden="true">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-green opacity-60"></span>
        <span class="relative inline-flex size-2 rounded-full bg-green"></span>
      </span>
      Based in Dublin, Ireland
      <span class="flex h-3 overflow-hidden rounded-[2px]" aria-hidden="true">
        <span class="w-1.5 bg-[#169b62]"></span><span class="w-1.5 bg-white"></span><span class="w-1.5 bg-[#ff883e]"></span>
      </span>
    </p>

    <h1 id="hero-title" class="text-brand pb-1 text-5xl leading-[1.05] font-black tracking-tight sm:text-6xl lg:text-7xl">
      Hryhorii Ilin
    </h1>

    <p class="text-lg text-muted-foreground sm:text-xl">
      Full-stack developer{" "}<span class="text-foreground/40" aria-hidden="true">·</span>{" "}infrastructure tinkerer{" "}
      <span class="text-foreground/40" aria-hidden="true">·</span>{" "}ex-sales director
    </p>

    <div
      class="glass flex h-12 max-w-xl items-center gap-2.5 overflow-hidden rounded-xl px-4 font-mono text-[15px]"
      data-typewriter
      data-phrases={JSON.stringify(PHRASES)}
    >
      <span class="text-violet" aria-hidden="true">~</span>
      <span class="text-green" aria-hidden="true">$</span>
      <span class="sr-only">{PHRASES.join(". ")}</span>
      <span class="truncate text-turquoise" aria-hidden="true" data-typewriter-text>{PHRASES[0]}</span>
      <span class="-ml-1 h-5 w-2.5 shrink-0 animate-blink rounded-[2px] bg-turquoise" aria-hidden="true"></span>
    </div>

    <ul class="flex flex-wrap gap-2" aria-label="Daily stack">
      {HERO_STACK.map((item) => <li class={badgeVariants({ variant: "chip" })}>{item}</li>)}
    </ul>

    <div class="flex flex-wrap gap-3 pt-2">
      <a href="#journey" class={buttonVariants({ variant: "brand", size: "xl" })}>
        Explore my journey
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
      </a>
      <a href={LINKS.github} target="_blank" rel="noopener noreferrer" class={buttonVariants({ variant: "outline", size: "xl" })}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path></svg>
        GitHub profile
      </a>
    </div>
  </div>

  <figure class="lg:col-span-5">
    <div class="glass relative overflow-hidden rounded-3xl p-4 shadow-[0_0_80px_-30px_var(--turquoise)]">
      <div class="mb-1 flex items-center justify-between px-1 font-mono text-[11px] tracking-widest text-muted-foreground uppercase">
        <span>contribution radar</span>
        <span class="flex items-center gap-1.5 text-green"><span class="size-1.5 rounded-full bg-green"></span>live</span>
      </div>
      <Fragment set:html={radar} />
    </div>
    <figcaption class="mt-3 text-center font-mono text-xs text-muted-foreground">
      every green square is a day of commits
    </figcaption>
  </figure>
</section>

<script>
  // Cycles the hero phrases with a typewriter effect. Stops when the element leaves the page.
  const TYPE_MS = 45;
  const DELETE_MS = 18;
  const HOLD_MS = 2200;

  function start(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "1";
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const target = root.querySelector<HTMLElement>("[data-typewriter-text]");
    const phrases: string[] = JSON.parse(root.dataset.phrases ?? "[]");
    if (!target || phrases.length < 2) return;

    let index = 0;
    let length = phrases[0]!.length;
    let deleting = true;
    const tick = () => {
      if (!root.isConnected) return;
      const phrase = phrases[index]!;
      if (deleting) {
        length--;
        if (length <= 0) {
          deleting = false;
          index = (index + 1) % phrases.length;
        }
      } else if (length < phrase.length) {
        length++;
      }
      target.textContent = phrases[index]!.slice(0, Math.max(0, length));
      const done = !deleting && length >= phrases[index]!.length;
      if (done) deleting = true;
      setTimeout(tick, done ? HOLD_MS : deleting ? DELETE_MS : TYPE_MS);
    };
    setTimeout(tick, HOLD_MS);
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-typewriter]").forEach(start);
  });
</script>
