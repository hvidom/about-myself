---
import { Code } from "astro:components";
import Highlighter from "@/components/magic/Highlighter.astro";
import { cardVariants } from "@/components/ui/card";
import { MERLIN_SLIDES, MERLIN_SNIPPETS, MERLIN_STATS, TONE } from "@/data/profile";
import { brandCodeTheme } from "@/lib/code-theme";
import { cn } from "@/lib/utils";
import MerlinVisual from "./MerlinVisual.astro";
import SectionHeading from "./SectionHeading.astro";

const sources = import.meta.glob<string>("../../data/merlin-snippets/*.ts.txt", {
  query: "?raw",
  import: "default",
  eager: true,
});
const source = (id: string) => {
  const code = sources[`../../data/merlin-snippets/${id}.ts.txt`];
  if (code === undefined) throw new Error(`Missing snippet ${id}`);
  return code.trimEnd();
};
const total = String(MERLIN_SLIDES.length).padStart(2, "0");
---

<section id="merlin" aria-labelledby="merlin-title" class="scroll-mt-24 space-y-10">
  <SectionHeading eyebrow="merlin --help" title="Meet Merlin" id="merlin-title" animation="/animations/like.lottie">
    The AI layer of Content Factory: a teammate in the chat, automations on a canvas and{" "}
    <Highlighter action="underline" tone="pink">a night shift for customers</Highlighter>. A short deck, then the code.
  </SectionHeading>

  <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
    {
      MERLIN_STATS.map((stat, i) => (
        <div class="glass flex flex-col-reverse rounded-2xl px-5 py-4">
          <dt class="mt-1 text-sm text-muted-foreground">{stat.label}</dt>
          <dd class={cn("text-3xl font-black", i % 2 ? "text-turquoise" : "text-violet")}>{stat.value}</dd>
        </div>
      ))
    }
  </dl>

  <div class={cn(cardVariants({ variant: "glass" }), "gap-0 overflow-hidden rounded-3xl py-0")} data-deck>
    <div class="flex items-center justify-between gap-3 border-b border-border px-5 py-3 font-mono text-xs text-muted-foreground">
      <span><span class="text-violet">~</span>/merlin/deck</span>
      <div class="flex items-center gap-2">
        <span aria-live="polite" data-deck-count>01 / {total}</span>
        <button
          type="button"
          class="grid size-8 place-items-center rounded-full border border-border transition-colors hover:border-turquoise/50 hover:text-turquoise disabled:opacity-40"
          aria-label="Previous slide"
          data-deck-prev
          disabled
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
        </button>
        <button
          type="button"
          class="grid size-8 place-items-center rounded-full border border-border transition-colors hover:border-turquoise/50 hover:text-turquoise disabled:opacity-40"
          aria-label="Next slide"
          data-deck-next
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
        </button>
      </div>
    </div>

    <ol
      class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain hide-scrollbar focus-visible:outline-offset-[-2px]"
      aria-label={`Merlin in ${MERLIN_SLIDES.length} slides`}
      tabindex="0"
      data-deck-track
    >
      {
        MERLIN_SLIDES.map((slide, i) => (
          <li
            class="grid w-full shrink-0 snap-start grid-cols-1 content-center gap-8 p-6 sm:p-10 md:grid-cols-2 md:items-center"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${MERLIN_SLIDES.length}`}
          >
            <div class="space-y-4">
              <p class={cn("font-mono text-xs font-bold tracking-widest", TONE[slide.tone].text)}>
                {String(i + 1).padStart(2, "0")} / {total}
              </p>
              <h3 class="text-2xl tracking-tight text-foreground sm:text-3xl">{slide.title}</h3>
              <p class="leading-relaxed text-muted-foreground">{slide.text}</p>
              <ul class="space-y-2 text-sm text-muted-foreground">
                {slide.points.map((point) => (
                  <li class="flex gap-2.5">
                    <span class={cn("mt-2 size-1.5 shrink-0 rounded-full", TONE[slide.tone].dot)} aria-hidden="true" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
            <MerlinVisual visual={slide.visual} />
          </li>
        ))
      }
    </ol>

    <div class="flex justify-center gap-2 border-t border-border py-3" data-deck-dots>
      {
        MERLIN_SLIDES.map((slide, i) => (
          <button
            type="button"
            class="h-1.5 w-4 rounded-full bg-muted-foreground/30 transition-all aria-[current=true]:w-8 aria-[current=true]:bg-turquoise"
            aria-label={`Slide ${i + 1}: ${slide.title}`}
            aria-current={i === 0 ? "true" : "false"}
          />
        ))
      }
    </div>
  </div>

  <div class="space-y-4">
    <div class="space-y-1">
      <h3 class="text-xl text-foreground">From the source</h3>
      <p class="text-sm text-muted-foreground">
        Real code from the private repository. Comments are translated from Russian; nothing personal is in it.
      </p>
    </div>

    <div class="glass overflow-hidden rounded-2xl font-mono" data-tabs data-source>
      <div class="flex items-center gap-2 border-b border-border bg-foreground/[0.03] px-4 py-2.5">
        <span class="size-3 shrink-0 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
        <span class="size-3 shrink-0 rounded-full bg-[#febc2e]" aria-hidden="true"></span>
        <span class="size-3 shrink-0 rounded-full bg-[#28c840]" aria-hidden="true"></span>
        <span class="flex-1 truncate text-center text-xs text-muted-foreground">hvidom@dublin: ~/content-factory — zsh</span>
        <span class="w-13 shrink-0" aria-hidden="true"></span>
      </div>
      <div role="tablist" aria-label="Code snippets" class="flex overflow-x-auto border-b border-border hide-scrollbar">
        {
          MERLIN_SNIPPETS.map((snippet, i) => (
            <button
              type="button"
              role="tab"
              id={`snippet-tab-${snippet.id}`}
              aria-controls={`snippet-${snippet.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="group flex shrink-0 items-center gap-2 border-r border-border px-3.5 py-2 text-xs whitespace-nowrap text-muted-foreground transition-colors hover:bg-foreground/5 hover:text-foreground aria-selected:bg-foreground/[0.06] aria-selected:text-foreground"
            >
              <span class="size-1.5 rounded-full bg-muted-foreground/40 transition-colors group-aria-selected:bg-turquoise group-aria-selected:shadow-[0_0_8px_var(--turquoise)]" aria-hidden="true" />
              {snippet.title}
            </button>
          ))
        }
      </div>
      <div class="grid grid-cols-1 px-4 py-3 text-xs leading-normal sm:px-5 sm:py-4">
        {
          MERLIN_SNIPPETS.map((snippet, i) => {
            const code = source(snippet.id);
            const command = `cat ${snippet.path}`;
            return (
              <div
                role="tabpanel"
                id={`snippet-${snippet.id}`}
                aria-labelledby={`snippet-tab-${snippet.id}`}
                class:list={["col-start-1 row-start-1 min-w-0 space-y-2", i !== 0 && "invisible"]}
                inert={i !== 0}
                data-source-panel
              >
                <p class="wrap-anywhere">
                  <span class="text-turquoise">hvidom</span><span class="text-muted-foreground">@</span><span class="text-violet">dublin</span>{" "}
                  <span class="text-muted-foreground">~/content-factory</span>{" "}<span class="text-green">$</span>{" "}
                  <span class="sr-only">{command}</span><span aria-hidden="true" data-type={command}>{command}</span><span class="ml-0.5 hidden h-[1.1em] w-2 animate-blink bg-turquoise align-text-bottom" aria-hidden="true" data-caret />
                </p>
                <p class="text-muted-foreground italic" data-line># {snippet.note}</p>
                <Code code={code} lang="ts" theme={brandCodeTheme} class="py-0.5" />
                <p class="text-green" data-line>✔ {code.split("\n").length} lines of TypeScript</p>
                <p data-line>
                  <span class="text-turquoise">hvidom</span><span class="text-muted-foreground">@</span><span class="text-violet">dublin</span>{" "}
                  <span class="text-muted-foreground">~/content-factory</span>{" "}<span class="text-green">$</span>{" "}
                  <span class="inline-block h-[1.1em] w-2 animate-blink bg-foreground align-text-bottom" aria-hidden="true" />
                </p>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  function deck(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "1";
    const track = root.querySelector<HTMLElement>("[data-deck-track]");
    const prev = root.querySelector<HTMLButtonElement>("[data-deck-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-deck-next]");
    const count = root.querySelector<HTMLElement>("[data-deck-count]");
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-deck-dots] button")];
    if (!track || !prev || !next || !count) return;
    const slides = track.children.length;
    const pad = (n: number) => String(n).padStart(2, "0");
    const index = () => Math.round(track.scrollLeft / (track.clientWidth || 1));
    let target = 0;
    let shown = 0;
    let settle = 0;
    const sync = (i: number) => {
      if (i === shown) return;
      shown = i;
      count.textContent = `${pad(i + 1)} / ${pad(slides)}`;
      prev.disabled = i === 0;
      next.disabled = i === slides - 1;
      dots.forEach((dot, d) => dot.setAttribute("aria-current", String(d === i)));
    };
    const go = (i: number) => {
      target = Math.max(0, Math.min(slides - 1, i));
      const smooth = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      track.scrollTo({ left: target * track.clientWidth, behavior: smooth ? "smooth" : "auto" });
      sync(target);
    };
    prev.addEventListener("click", () => go(target - 1));
    next.addEventListener("click", () => go(target + 1));
    dots.forEach((dot, d) => dot.addEventListener("click", () => go(d)));
    track.addEventListener(
      "scroll",
      () => {
        window.clearTimeout(settle);
        settle = window.setTimeout(() => {
          target = index();
          sync(target);
        }, 120);
      },
      { passive: true },
    );
    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
        event.preventDefault();
        go(target + (event.key === "ArrowRight" ? 1 : -1));
      }
    });
  }

  const TYPE_MS = 28;
  const LINE_MS = 32;

  function tabs(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "1";
    const list = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panelOf = (tab: HTMLButtonElement) => document.getElementById(tab.getAttribute("aria-controls") ?? "");
    const animate = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let run = 0;
    let seen = false;

    const finish = (panel: HTMLElement) => {
      delete panel.dataset.playing;
      const typed = panel.querySelector<HTMLElement>("[data-type]");
      if (typed) typed.textContent = typed.dataset.type ?? "";
      panel.querySelector<HTMLElement>("[data-caret]")?.classList.add("hidden");
    };

    const play = (panel: HTMLElement) => {
      const id = ++run;
      const typed = panel.querySelector<HTMLElement>("[data-type]");
      const caret = panel.querySelector<HTMLElement>("[data-caret]");
      const lines = [...panel.querySelectorAll<HTMLElement>(".line, [data-line]")];
      const command = typed?.dataset.type ?? "";
      for (const line of lines) delete line.dataset.shown;
      panel.dataset.playing = "1";
      if (typed) typed.textContent = "";
      caret?.classList.remove("hidden");

      let chars = 0;
      let shown = 0;
      const step = () => {
        if (id !== run || !panel.isConnected) return;
        if (chars < command.length) {
          chars++;
          if (typed) typed.textContent = command.slice(0, chars);
          window.setTimeout(step, TYPE_MS);
          return;
        }
        caret?.classList.add("hidden");
        const line = lines[shown++];
        if (!line) return finish(panel);
        line.dataset.shown = "1";
        window.setTimeout(step, LINE_MS);
      };
      window.setTimeout(step, TYPE_MS * 4);
    };

    const select = (tab: HTMLButtonElement) => {
      for (const other of list) {
        const on = other === tab;
        other.setAttribute("aria-selected", String(on));
        other.tabIndex = on ? 0 : -1;
        const panel = panelOf(other);
        if (!panel) continue;
        panel.classList.toggle("invisible", !on);
        panel.inert = !on;
        if (!on) finish(panel);
      }
      const panel = panelOf(tab);
      if (panel && animate && seen) play(panel);
    };

    list.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        const target = list[(i + step + list.length) % list.length];
        if (!target) return;
        select(target);
        target.focus();
      });
    });

    if (!animate) return;
    const first = list.find((tab) => tab.getAttribute("aria-selected") === "true");
    const firstPanel = first && panelOf(first);
    if (!firstPanel) return;
    firstPanel.dataset.playing = "1";
    const typed = firstPanel.querySelector<HTMLElement>("[data-type]");
    if (typed) typed.textContent = "";
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        seen = true;
        const active = list.find((tab) => tab.getAttribute("aria-selected") === "true");
        const panel = active && panelOf(active);
        if (panel) play(panel);
      },
      { threshold: 0.25 },
    );
    observer.observe(root);
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-deck]").forEach(deck);
    document.querySelectorAll<HTMLElement>("[data-tabs]").forEach(tabs);
  });
</script>

<style>
  [data-source-panel] :global(.line) {
    display: inline-block;
  }
  [data-source-panel] :global(:is(.line, [data-line])) {
    transition:
      opacity 0.3s ease-out,
      transform 0.3s ease-out;
  }
  [data-source-panel][data-playing] :global(:is(.line, [data-line]):not([data-shown])) {
    opacity: 0;
    transform: translateY(-5px);
  }
</style>
