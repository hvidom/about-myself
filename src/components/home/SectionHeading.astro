---
// Section header: a mono "command" eyebrow, the title, and an optional lead paragraph.
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  align?: "left" | "center";
}

const { eyebrow, title, id, align = "left" } = Astro.props;
---

<div class:list={["max-w-2xl space-y-3", align === "center" && "mx-auto text-center"]}>
  <p class="font-mono text-sm text-turquoise">
    <span class="text-violet">~</span> <span class="text-green">$</span>{" "}{eyebrow}
  </p>
  <h2 id={id} class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">{title}</h2>
  {
    Astro.slots.has("default") && (
      <p class="text-base leading-relaxed text-muted-foreground">
        <slot />
      </p>
    )
  }
</div>
