<div
  id="global-preloader"
  transition:persist
  aria-hidden="true"
  class="pointer-events-none invisible fixed inset-0 z-150 flex flex-col items-center justify-center bg-background opacity-0 transition-[opacity,visibility] duration-300"
>
  <div class="flex flex-col items-center gap-4">
    <div class="size-10 animate-spin rounded-full border-4 border-muted border-t-turquoise border-r-green"></div>
    <p class="font-mono text-xs tracking-[0.3em] text-muted-foreground uppercase">loading</p>
  </div>
</div>

<script>
  const setVisible = (visible: boolean) => {
    const loader = document.getElementById("global-preloader");
    if (!loader) return;
    for (const name of ["invisible", "opacity-0", "pointer-events-none"]) loader.classList.toggle(name, !visible);
  };

  document.addEventListener("astro:before-preparation", () => setVisible(true));
  document.addEventListener("astro:after-swap", () => setVisible(false));
  document.addEventListener("astro:page-load", () => setVisible(false));
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) setVisible(false);
  });
</script>
