---
// Full-screen loader shown during ClientRouter navigations.
---

<div
  id="global-preloader"
  transition:persist
  class="pointer-events-none fixed inset-0 z-150 flex flex-col items-center justify-center bg-background opacity-100 transition-opacity duration-300"
>
  <div class="flex flex-col items-center gap-4">
    <div class="size-10 animate-spin rounded-full border-4 border-muted border-t-turquoise border-r-green" role="status" aria-label="Loading"></div>
    <p class="font-mono text-xs tracking-[0.3em] text-muted-foreground uppercase">loading</p>
  </div>
</div>

<script>
  const setVisible = (visible: boolean) => {
    const loader = document.getElementById("global-preloader");
    if (!loader) return;
    loader.style.opacity = visible ? "1" : "0";
    loader.style.pointerEvents = visible ? "auto" : "none";
  };

  if (document.readyState === "complete") {
    setVisible(false);
  } else {
    window.addEventListener("load", () => setVisible(false));
  }

  document.addEventListener("astro:before-preparation", () => setVisible(true));
  document.addEventListener("astro:after-swap", () => setVisible(false));
  document.addEventListener("astro:page-load", () => setVisible(false));
</script>
