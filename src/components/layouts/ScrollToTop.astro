<button
  id="scroll-to-top"
  type="button"
  class="pointer-events-none invisible fixed right-6 bottom-6 z-50 flex size-10 translate-y-20 items-center justify-center rounded-full border border-border/40 bg-background/80 text-muted-foreground opacity-0 shadow-md backdrop-blur-sm transition-all duration-300 hover:bg-muted hover:text-primary active:scale-95"
  aria-label="Scroll to top"
>
  <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18"></path>
  </svg>
</button>

<script>
  const HIDDEN = ["pointer-events-none", "invisible", "translate-y-20", "opacity-0"];
  let controller: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    controller?.abort();
    const button = document.getElementById("scroll-to-top");
    if (!button) return;
    controller = new AbortController();
    const { signal } = controller;
    const toggle = () => {
      const hidden = window.scrollY <= 300;
      for (const name of HIDDEN) button.classList.toggle(name, hidden);
    };
    window.addEventListener("scroll", toggle, { passive: true, signal });
    button.addEventListener("click", () => window.scrollTo({ top: 0 }), { signal });
    toggle();
  });
</script>
