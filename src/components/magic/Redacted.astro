---
interface Props {
  delay?: number;
}

const { delay = 0 } = Astro.props;
---

<span class="redacted" data-redacted="" data-delay={delay}><slot /></span>

<style>
  .redacted {
    position: relative;
    display: inline;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .redacted[data-redacted="armed"],
  .redacted[data-redacted="open"] {
    background-image: linear-gradient(var(--foreground), var(--foreground));
    background-repeat: no-repeat;
    background-position: right center;
    background-size: 100% 88%;
    color: transparent;
    transition:
      background-size 0.7s cubic-bezier(0.7, 0, 0.3, 1),
      color 0.2s ease 0.45s;
  }
  .redacted[data-redacted="open"] {
    background-size: 0% 88%;
    color: inherit;
  }
</style>

<script>
  const open = (el: HTMLElement) => {
    window.setTimeout(() => {
      el.dataset.redacted = "open";
    }, Number(el.dataset.delay ?? 0));
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        open(entry.target as HTMLElement);
      }
    },
    { rootMargin: "0px 0px -20% 0px" },
  );

  document.addEventListener("astro:page-load", () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    for (const el of document.querySelectorAll<HTMLElement>('[data-redacted=""]')) {
      el.dataset.redacted = "armed";
      el.addEventListener("pointerenter", () => open(el), { once: true });
      observer.observe(el);
    }
  });
</script>
