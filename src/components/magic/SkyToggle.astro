---
// Blue or black night sky. Port of Magic UI's Animated Theme Toggler: the new sky grows as a
// circle from the button (View Transitions API). Without the API, or with reduced motion, the sky
// just switches. BaseHead applies the stored choice before the first paint.
---

<button
  type="button"
  class="group grid size-9 place-items-center rounded-lg text-muted-foreground transition-colors hover:bg-muted/60 hover:text-turquoise"
  aria-label="Black sky"
  aria-pressed="false"
  title="Switch to the black sky"
  data-sky-toggle
>
  <svg viewBox="0 0 24 24" class="size-[18px] transition-transform duration-500 group-aria-pressed:rotate-180" aria-hidden="true">
    <circle cx="12" cy="12" r="9" fill="#0b1130"></circle>
    <path d="M12 3a9 9 0 0 1 0 18z" fill="#000"></path>
    <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <circle cx="8" cy="9" r="1" fill="#fff"></circle>
    <circle cx="16" cy="15" r="1" fill="#fff"></circle>
  </svg>
</button>

<script>
  import { applySky, currentSky } from "@/lib/sky";

  const sync = () => {
    const black = currentSky() === "black";
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-sky-toggle]")) {
      button.setAttribute("aria-pressed", String(black));
      button.title = black ? "Switch to the blue sky" : "Switch to the black sky";
    }
  };

  async function toggle(button: HTMLElement) {
    const next = currentSky() === "black" ? "blue" : "black";
    const swap = () => {
      applySky(next, true);
      sync();
    };
    const root = document.documentElement;
    if (!document.startViewTransition || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      swap();
      return;
    }
    // Scoped by class so ClientRouter's page transitions keep their own animation.
    root.classList.add("sky-switching");
    const transition = document.startViewTransition(swap);
    transition.finished.finally(() => root.classList.remove("sky-switching"));
    await transition.ready;
    const { top, left, width, height } = button.getBoundingClientRect();
    const x = left + width / 2;
    const y = top + height / 2;
    const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
    root.animate(
      { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
      { duration: 700, easing: "ease-in-out", pseudoElement: "::view-transition-new(root)" },
    );
  }

  document.addEventListener("astro:page-load", () => {
    sync();
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-sky-toggle]")) {
      if (button.dataset.ready) continue;
      button.dataset.ready = "1";
      button.addEventListener("click", () => toggle(button));
    }
  });
</script>
