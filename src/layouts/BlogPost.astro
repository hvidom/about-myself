---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Header from "@/components/Header.astro";
import { badgeVariants } from "@/components/ui/badge";
import { cn } from "@/lib/utils";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"blog">["data"] & {
  minutesRead?: string;
};

const { title, description, pubDate, updatedDate, heroImage, minutesRead, category, tags } =
  Astro.props;
---

<Layout title={title} description={description}>
  <Header />

  <main id="main" class="mx-auto max-w-3xl px-5 py-12 sm:px-6">
    <article class="space-y-10">
      <header class="space-y-5">
        <a href="/blog/" class="group inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground transition-colors hover:text-turquoise">
          <span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span> cd ../blog
        </a>

        {category && <span class={cn(badgeVariants({ variant: "turquoise" }), "ml-3 h-6 px-2.5 font-mono uppercase")}>{category}</span>}

        <h1 class="text-3xl font-black tracking-tight text-balance text-foreground sm:text-4xl md:text-5xl">{title}</h1>
        <p class="text-lg leading-relaxed text-muted-foreground">{description}</p>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-border pb-6 text-xs text-muted-foreground">
          <span class="flex items-center gap-2">
            <span
              class="grid size-7 place-items-center rounded-full border border-turquoise/30 bg-turquoise/10 font-mono text-[10px] font-bold text-turquoise"
              aria-hidden="true">HI</span
            >
            <span class="font-medium text-foreground">Hryhorii Ilin</span>
          </span>
          <span aria-hidden="true">·</span>
          <FormattedDate date={pubDate} />
          {
            minutesRead && (
              <>
                <span aria-hidden="true">·</span>
                <span class="rounded-full bg-muted px-2.5 py-0.5 font-mono">{minutesRead}</span>
              </>
            )
          }
          {
            updatedDate && (
              <span class="italic">
                (updated <FormattedDate date={updatedDate} />)
              </span>
            )
          }
        </div>
      </header>

      {
        heroImage && (
          <div class="glass overflow-hidden rounded-3xl p-2">
            <Image
              width={1200}
              height={600}
              src={heroImage}
              alt=""
              class="aspect-2/1 max-h-[420px] w-full rounded-2xl object-cover"
              loading="eager"
            />
          </div>
        )
      }

      <div class="prose max-w-none">
        <slot />
      </div>

      {
        tags && tags.length > 0 && (
          <ul class="flex flex-wrap gap-2 border-t border-border pt-6" aria-label="Tags">
            {tags.map((tag) => (
              <li class={badgeVariants({ variant: "chip" })}>#{tag}</li>
            ))}
          </ul>
        )
      }
    </article>
  </main>

  <Footer />
</Layout>
