---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FileTag from "@/components/FileTag.astro";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Header from "@/components/Header.astro";
import Stamp from "@/components/magic/Stamp.astro";
import { badgeVariants } from "@/components/ui/badge";
import { FILE_ID } from "@/data/dossier";
import { cn } from "@/lib/utils";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"blog">["data"] & {
  minutesRead?: string;
  fileId?: string;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  minutesRead,
  category,
  tags,
  fileId,
  releaseNote,
} = Astro.props;
const reference = fileId ? `${FILE_ID}/${fileId}` : FILE_ID;
---

<Layout
  title={title}
  description={description}
  image={heroImage?.src}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate }}
>
  <Header />

  <main id="main" class="mx-auto max-w-3xl px-5 py-12 sm:px-6">
    <article class="space-y-10">
      <header class="relative space-y-5 overflow-x-clip">
        <a href="/blog/" class="group inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground transition-colors hover:text-turquoise">
          <span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span> cd ../archive
        </a>

        <div class="flex flex-wrap items-center gap-2">
          <FileTag>File {reference}</FileTag>{" "}
          {category && <span class={cn(badgeVariants({ variant: "turquoise" }), "h-6 px-2.5 font-mono uppercase")}>{category}</span>}{" "}
          <span class={cn(badgeVariants({ variant: "green" }), "h-6 px-2.5 font-mono uppercase")}>Clearance: public</span>
        </div>

        <Stamp text="Declassified" sub="for public release" tilt={9} class="absolute top-1 right-3 hidden text-base md:inline-flex" />

        <h1 class="text-3xl font-black tracking-tight text-balance text-foreground sm:text-4xl md:text-5xl">{title}</h1>
        <p class="text-lg leading-relaxed text-muted-foreground">{description}</p>
        {
          releaseNote && (
            <p class="rounded-xl border border-dashed border-gold/35 bg-gold/5 px-4 py-3 font-mono text-xs leading-relaxed text-muted-foreground">
              <span class="tracking-[0.2em] text-gold uppercase">Cleared for release:</span> {releaseNote}
            </p>
          )
        }

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-border pb-6 text-xs text-muted-foreground">
          <span class="flex items-center gap-2">
            <span
              class="grid size-7 place-items-center rounded-full border border-turquoise/30 bg-turquoise/10 font-mono text-[10px] font-bold text-turquoise"
              aria-hidden="true">HI</span
            >
            <span class="font-medium text-foreground">Hryhorii Ilin</span>
          </span>
          <span aria-hidden="true">·</span>
          <FormattedDate date={pubDate} />
          {
            minutesRead && (
              <>
                <span aria-hidden="true">·</span>
                <span class="rounded-full bg-muted px-2.5 py-0.5 font-mono">{minutesRead}</span>
              </>
            )
          }
          {
            updatedDate && (
              <span class="italic">
                (updated <FormattedDate date={updatedDate} />)
              </span>
            )
          }
        </div>
      </header>

      {
        heroImage && (
          <div class="glass overflow-hidden rounded-3xl p-2">
            <Image
              width={1200}
              height={600}
              src={heroImage}
              alt=""
              class="aspect-2/1 max-h-[420px] w-full rounded-2xl object-cover"
              loading="eager"
            />
          </div>
        )
      }

      <div class="prose max-w-none">
        <slot />
      </div>

      <footer class="space-y-6 border-t border-border pt-6">
        {
          tags && tags.length > 0 && (
            <ul class="flex flex-wrap gap-2" aria-label="Tags">
              {tags.map((tag) => (
                <li class={badgeVariants({ variant: "chip" })}>#{tag}</li>
              ))}
            </ul>
          )
        }
        <p class="text-center font-mono text-[10px] tracking-[0.3em] text-gold/70 uppercase">
          End of file · {reference} · burn after reading <span class="normal-case tracking-normal">(or bookmark it, we won't tell)</span>
        </p>
      </footer>
    </article>
  </main>

  <Footer />
</Layout>
