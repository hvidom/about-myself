---
import BaseHead from "@/components/layouts/BaseHead.astro";
import Preloader from "@/components/layouts/Preloader.astro";
import ScrollToTop from "@/components/layouts/ScrollToTop.astro";
import SpaceBackground from "@/components/layouts/SpaceBackground.astro";
import { cn } from "@/lib/utils";

type Props = {
  title: string;
  description?: string;
  mainClass?: string;
};

const { title, description, mainClass } = Astro.props;

// Prerendered pages are served as static assets; headers only apply to on-demand pages.
if (!Astro.isPrerendered) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=0, s-maxage=31536000, must-revalidate",
  );
}
---

<html lang="en" class="dark scroll-smooth">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body
    class="relative min-h-screen overflow-x-hidden bg-background font-sans text-foreground antialiased selection:bg-turquoise/40 selection:text-foreground"
  >
    <a
      href="#main"
      class="sr-only z-[200] rounded-lg bg-primary px-4 py-2 text-primary-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Skip to content</a
    >
    <Preloader />
    <SpaceBackground />
    <div class={cn("relative z-10 min-h-screen w-full", mainClass)}>
      <slot />
    </div>
    <ScrollToTop />
  </body>
</html>
