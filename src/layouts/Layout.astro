---
import BaseHead from "@/components/layouts/BaseHead.astro";
import Preloader from "@/components/layouts/Preloader.astro";
import ScrollToTop from "@/components/layouts/ScrollToTop.astro";
import SpaceBackground from "@/components/layouts/SpaceBackground.astro";
import { cn } from "@/lib/utils";
import { ClientRouter } from "astro:transitions";

type Props = {
  title: string;
  description?: string;
  mainClass?: string;
};

const { title, description, mainClass } = Astro.props;
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=31536000, must-revalidate",
);
---

<html lang="en" class="scroll-smooth" data-astro-transition-persist="theme">
  <head>
    <BaseHead title={title} description={description} />
    <ClientRouter />
  </head>
  <body class="font-sans min-h-screen bg-background text-foreground relative overflow-x-hidden antialiased selection:bg-primary selection:text-primary-foreground">
    <Preloader />

    <SpaceBackground />
    <div class="relative z-10 w-full min-h-screen pointer-events-none">

      <main class={cn("pointer-events-auto", mainClass)}>
        <slot />
        <ScrollToTop />
      </main>
    </div>
  </body>
</html>