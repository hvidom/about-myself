---
import BaseHead from "@/components/layouts/BaseHead.astro";
import Preloader from "@/components/layouts/Preloader.astro";
import ScrollToTop from "@/components/layouts/ScrollToTop.astro";
import SpaceBackground from "@/components/layouts/SpaceBackground.astro";
import { cn } from "@/lib/utils";

type Props = {
  title: string;
  description?: string;
  image?: string;
  article?: { publishedTime: Date; modifiedTime?: Date | undefined };
  mainClass?: string;
};

const { title, description, image, article, mainClass } = Astro.props;

if (!Astro.isPrerendered) {
  Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=300, must-revalidate");
}
---

<html lang="en" class="dark scroll-smooth">
  <head>
    <BaseHead title={title} description={description} image={image} article={article} />
  </head>
  <body
    class="relative min-h-screen overflow-x-hidden bg-background font-sans text-foreground antialiased"
  >
    <a
      href="#main"
      class="sr-only z-[200] rounded-lg bg-primary px-4 py-2 text-primary-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Skip to content</a
    >
    <Preloader />
    <SpaceBackground />
    <div class={cn("relative z-10 min-h-screen w-full", mainClass)}>
      <slot />
    </div>
    <ScrollToTop />
  </body>
</html>
