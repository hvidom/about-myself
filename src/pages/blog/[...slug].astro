---
import { render } from "astro:content";
import { fileIds, publishedPosts } from "@/lib/posts";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  const files = fileIds(posts);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, fileId: files.get(post.id) ?? "" },
  }));
}

const { post, fileId } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
export const prerender = true;
---

<BlogPost {...post.data} fileId={fileId} minutesRead={remarkPluginFrontmatter.minutesRead}>
	<Content />
</BlogPost>