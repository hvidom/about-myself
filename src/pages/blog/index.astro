---
import { Image } from "astro:assets";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Header from "@/components/Header.astro";
import LottieAnimation from "@/components/LottieAnimations.astro";
import { badgeVariants } from "@/components/ui/badge";
import { cardVariants } from "@/components/ui/card";
import Layout from "@/layouts/Layout.astro";
import { publishedPosts } from "@/lib/posts";
import { cn } from "@/lib/utils";

export const prerender = true;

const posts = await publishedPosts();
---

<Layout
  title="Blog"
  description="Articles by Hryhorii Ilin (hvidom) on full-stack web development, CRM automation, cloud operations and sales systems."
>
  <Header />

  <main id="main" class="mx-auto max-w-6xl space-y-12 px-5 py-16 sm:px-6">
    <div class="max-w-2xl space-y-3">
      <p class="font-mono text-sm text-turquoise"><span class="text-violet">~</span> <span class="text-green">$</span> ls ~/blog</p>
      <h1 class="text-4xl font-black tracking-tight sm:text-5xl"><span class="text-brand">Writing & insights</span></h1>
      <p class="text-muted-foreground">
        Articles on full-stack web development, CRM automation, scalable cloud operations and sales methodology.
      </p>
    </div>

    {
      posts.length === 0 && (
        <div class="glass grid-faint rounded-3xl p-10 text-center">
          <LottieAnimation src="/animations/meditation.lottie" class="mx-auto mb-4 size-40" />
          <p class="font-mono text-sm text-muted-foreground">
            <span class="text-green">$</span> ls ~/blog
            <br />
            <span class="text-turquoise">total 0</span>, first posts are being written.
          </p>
        </div>
      )
    }

    <ul class="grid gap-6 md:grid-cols-2">
      {
        posts.map((post, index) => {
          const featured = index === 0;
          return (
            <li class:list={[featured && "md:col-span-2"]}>
              <a
                href={`/blog/${post.id}/`}
                class={cn(
                  cardVariants({ variant: "glass" }),
                  "group h-full gap-0 rounded-3xl py-0",
                  featured && post.data.heroImage && "md:flex-row",
                )}
              >
                {post.data.heroImage && (
                  <div class:list={["relative overflow-hidden bg-muted/30", featured ? "aspect-video md:aspect-auto md:w-1/2" : "aspect-2/1"]}>
                    <Image
                      width={featured ? 960 : 720}
                      height={featured ? 540 : 360}
                      src={post.data.heroImage}
                      alt=""
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-linear-to-t from-background/60 to-transparent" />
                  </div>
                )}
                <div class:list={["flex flex-1 flex-col justify-between gap-6 p-6 sm:p-7", featured && post.data.heroImage && "md:w-1/2"]}>
                  <div class="space-y-3">
                    <div class="flex flex-wrap items-center gap-2 font-mono text-[11px] text-muted-foreground uppercase">
                      <FormattedDate date={post.data.pubDate} />
                      {post.data.category && <span class={cn(badgeVariants({ variant: "turquoise" }), "h-5")}>{post.data.category}</span>}
                    </div>
                    <h2 class:list={["leading-tight font-bold text-foreground transition-colors group-hover:text-turquoise", featured ? "text-2xl sm:text-3xl" : "text-xl"]}>
                      {post.data.title}
                    </h2>
                    <p class="line-clamp-3 text-sm leading-relaxed text-muted-foreground">{post.data.description}</p>
                  </div>
                  <div class="flex items-center justify-between border-t border-border pt-4 font-mono text-xs text-muted-foreground">
                    <span>read article</span>
                    <span class="text-turquoise transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
                  </div>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </main>

  <Footer />
</Layout>
