---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { Image } from "astro:assets";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout 
  title="Blog | hvidom"
  description="Personal blog and technical articles of Hryhorii Ilin (hvidom). Exploring software engineering, data analytics, strategy, and infrastructure."
>
  <Header />

  <main class="max-w-6xl mx-auto px-6 py-16 space-y-12">
    <!-- Blog Section Header -->
    <div class="space-y-4">
      <h1>Writing & Insights</h1>
      <div class="h-1 w-20 bg-linear-to-r from-primary to-emerald-400 rounded-full"></div>
      <p>
        Articles on full-stack web development, CRM automating systems, scalable cloud operations, and strategic sales methodologies.
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8">
      {posts.map((post, index) => {
        const isFeatured = index === 0;
        return (
          <a 
            href={`/blog/${post.id}/`} 
            class:list={[
              "group bg-card/30 hover:bg-card/50 border border-border/60 hover:border-primary/45 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col justify-between",
              isFeatured ? "md:col-span-2 md:flex-row" : ""
            ]}
          >
            {/* Optional Image */}
            {post.data.heroImage && (
              <div class:list={[
                "overflow-hidden bg-muted/20 relative",
                isFeatured ? "md:w-1/2 aspect-video md:aspect-auto min-h-[240px]" : "aspect-2/1 w-full"
              ]}>
                <Image 
                  width={720} 
                  height={360} 
                  src={post.data.heroImage} 
                  alt="" 
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-linear-to-t from-background/40 to-transparent"></div>
              </div>
            )}

            {/* Post Content */}
            <div class:list={[
              "p-6 flex flex-col justify-between flex-1 gap-6",
              isFeatured && post.data.heroImage ? "md:w-1/2" : ""
            ]}>
              <div class="space-y-4">
                <div class="flex items-center gap-2.5">
                  <span class="text-[10px] font-mono text-muted-foreground uppercase">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                  {post.data.category && (
                    <>
                      <span class="text-border text-xs">•</span>
                      <span class="text-[10px] font-mono text-primary font-bold uppercase tracking-wider bg-primary/10 px-2 py-0.5 rounded border border-primary/20">
                        {post.data.category}
                      </span>
                    </>
                  )}
                </div>

                <h2 class="text-xl font-bold leading-tight group-hover:text-primary transition-colors">
                  {post.data.title}
                </h2>
                
                <p class="text-sm text-muted-foreground leading-relaxed line-clamp-3">
                  {post.data.description}
                </p>
              </div>

              <div class="flex items-center justify-between text-xs text-muted-foreground border-t border-border/30 pt-4">
                <span class="font-medium group-hover:text-foreground transition-colors">Read Article</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1 size-4"><line x1="5" x2="19" y1="12" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </main>

  <Footer />
</Layout>
