---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Contact from "@/components/home/Contact.astro";
import Expertise from "@/components/home/Expertise.astro";
import FeaturedWork from "@/components/home/FeaturedWork.astro";
import Hero from "@/components/home/Hero.astro";
import Journey from "@/components/home/Journey.astro";
import RecentPosts from "@/components/home/RecentPosts.astro";
import Stack from "@/components/home/Stack.astro";
import Telemetry from "@/components/home/Telemetry.astro";
import Terminal from "@/components/home/Terminal.astro";
import Layout from "@/layouts/Layout.astro";
import { publishedPosts } from "@/lib/posts";

export const prerender = true;

const posts = (await publishedPosts()).slice(0, 3);
---

<Layout
  title="hvidom · Hryhorii Ilin, full-stack developer"
  description="Hryhorii Ilin (hvidom): full-stack developer, infrastructure tinkerer and ex-sales director in Dublin. Projects, journey, tech stack and writing."
>
  <Header />

  <main id="main" class="mx-auto max-w-6xl space-y-32 px-5 py-14 sm:px-6">
    <Hero />
    <Terminal />
    <Journey />
    <FeaturedWork />
    <Expertise />
    <Stack />
    <Telemetry />
    {posts.length > 0 && <RecentPosts posts={posts} />}
    <Contact />
  </main>

  <Footer />
</Layout>
